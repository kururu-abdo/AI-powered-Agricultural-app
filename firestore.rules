rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function member(farmId) {
      return verified() && exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid));
    }
    function role(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)).data.role;
    }
    function staff(farmId) {
      return member(farmId) && role(farmId) in ['owner', 'manager'];
    }
    match /users/{uid}/farms/{farmId} {
      // Server-maintained discovery index. Contains IDs/roles, no farm content.
      allow read: if verified() && request.auth.uid == uid;
      allow write: if false;
    }
    match /farms/{farmId} {
      allow get: if member(farmId);
      allow list, write: if false;
      match /members/{uid} {
        allow get: if member(farmId) && (request.auth.uid == uid || staff(farmId));
        allow list: if staff(farmId);
        allow write: if false;
      }
      match /audit/{eventId} {
        allow read: if member(farmId) && role(farmId) == 'owner';
        allow write: if false;
      }
    }
    // Agricultural records get explicit scoped rules when implemented.
    match /{document=**} { allow read, write: if false; }
  }
}
